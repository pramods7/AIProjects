# ---- Demo chatbot (Subsystem D) ----
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
CHAT_PROVIDER=openai            # openai | groq
CHAT_MODEL_OPENAI=gpt-4o-mini
CHAT_MODEL_GROQ=llama-3.3-70b-versatile

# STT (speech-to-text)
STT_PROVIDER=openai             # openai (whisper-1) | groq (whisper-large-v3)
STT_MODEL_OPENAI=whisper-1
STT_MODEL_GROQ=whisper-large-v3

# TTS (text-to-speech) - OpenAI only for now
TTS_PROVIDER=openai
TTS_MODEL_OPENAI=tts-1
TTS_VOICE=alloy

# Vision (video/image understanding)
VISION_PROVIDER=openai          # openai (gpt-4o-mini) | groq (llama-3.2-90b-vision-preview)
VISION_MODEL_OPENAI=gpt-4o-mini
VISION_MODEL_GROQ=llama-3.2-90b-vision-preview

# ---- DeepEval judge (Subsystem E test framework) ----
JUDGE_PROVIDER=openai           # openai | groq | ollama
JUDGE_MODEL_OPENAI=gpt-4o-mini
JUDGE_MODEL_GROQ=openai/gpt-oss-120b
JUDGE_MODEL_OLLAMA=gpt-oss:20b

# ---- Target under test ----
# Point this at the demo chatbot OR at YOUR OWN live chatbot.
# See framework/targets_config.yaml for full per-modality mapping.
TARGET_CONFIG=framework/targets_config.yaml
